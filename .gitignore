# Python Virtual Environments
.venv/
venv/
env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Test & Type Checking Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local Environment Variables & Secrets
.env
.env.*
!.env.example

# Runtime Outputs & Logs
outputs/*.json
outputs/publications/
!outputs/.gitkeep
*.log

# Runtime Databases
data/*.db
data/*.sqlite3
data/*.db-journal
data/*.db-wal
data/*.db-shm
!data/.gitkeep


# OS & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

