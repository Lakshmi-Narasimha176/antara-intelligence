# ANTARĀ Intelligence Engine - Environment Configuration Template
# Copy this file to .env and configure local values. Do NOT commit .env to version control.

# Structured Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
ANTARA_LOG_LEVEL=INFO

# OpenAI Provider Configuration (Official SDK)
# Do NOT hardcode API keys. Keep this file filled with placeholders only.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2
